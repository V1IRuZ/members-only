<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Messages</title>
  <link rel="stylesheet" href="/styles.css">
</head>

<body>
  <div class="page">
    <%- include('partials/header') %>
    <main class="content">
      <div class="messages">
        <div class="filter">
          <a href="/messages">ALL</a>
          <a href="/messages/members">MEMBERS</a>
        </div>
        <div class="sort">
          <a href="<%= sort === "oldest" ? path + "?sort=newest" : path + "?sort=oldest" %>">
            <img src="<%= sort === 'oldest' ? '/icons/sort-clock-asc.svg' : '/icons/sort-clock-desc.svg' %>" alt="">
          </a>
        </div>
      </div>
      <% if (locals.currentUser) { %>
      <div class="new">
        <a href="/messages/new" class="new-message">
          <img src="/icons/add.svg" alt="">
          <span>NEW MESSAGE</span>
        </a>
      </div>
      <% } %>
      <%- include('partials/message-list', {msgs: msgs}) %>
    </main>
    <%- include('partials/footer') %>
  </div>
</body>

</html>