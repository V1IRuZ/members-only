<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Messages</title>
  <link rel="stylesheet" href="/styles.css">
</head>

<body>
  <div class="page">
    <%- include('partials/header') %>
    <main class="content">
      <div class="messages">
        <h2>MESSAGES</h2>
        <div class="sort">
          <a href="/messages?sort=newest">NEWEST</a>
          <a href="/messages?sort=oldest">OLDEST</a>
        </div>
        <% if (locals.currentUser) { %>
        <a href="/messages/new" class="new-message">
          <img src="/icons/add.svg" alt="">
          <span>NEW MESSAGE</span>
        </a>
        <% } %>
      </div>
      <%- include('partials/message-list', {msgs: msgs}) %>
    </main>
    <%- include('partials/footer') %>
  </div>
</body>

</html>