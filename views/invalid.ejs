<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Error</title>
  <link rel="stylesheet" href="/styles.css">
</head>

<body>
  <div class="page">
    <%- include('header') %>
    <main class="error">
      <h2>Oops! Something Went Wrong.</h2>
      <div class="error-msg">
        <h3><%= status %> <%= name %></h3>
        <%- include('partials/errors', {errors: errors}) %>
      </div>
    </main>
    <%- include('footer') %>
  </div>
</body>

</html>