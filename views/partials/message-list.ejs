<ul class="msg-list">
  <% msgs.map((msg) => { %>
  <li class="msg">
    <div class="profile">
      <img src="<%= msg.role == 0 ? '/icons/account.svg' : msg.role === 1 ? '/icons/account-star.svg' : '/icons/account-tie.svg' %>" alt="">
      <% if (currentUser?.role > 0) { %>
      <h3><%= msg.username %></h3>
      <% } %>
    </div>
    <div class="text">
      <div>
        <h2><%= msg.title %></h2>
        <p><%= msg.message %></p>
      </div>
      <% if (currentUser?.role > 0) { %>
      <span><%= msg.created_at %></span>
      <% } %>
    </div>
    <% if (currentUser?.role > 1) { %>
    <div class="admin-remove">
      <form action="/messages/<%= msg.id %>/delete" method="post" class="remove-form">
        <button class="delete" type="submit" onclick="return confirm('Are you sure you want to delete this message?');">DELETE MESSAGE</button>
      </form>
    </div>
    <% } %>
  </li>
  <% }) %>
</ul>