<ul class="msg-list">
  <% msgs.map((msg) => { %>
  <li class="msg">
    <div class="profile">
      <img src="<%= msg.role > 0 ? '/icons/account-star.svg' : '/icons/account.svg' %>" alt="">
      <% if (currentUser?.role > 0) { %>
      <h3><%= msg.username %></h3>
      <% } %>
    </div>
    <div class="text">
      <div>
        <h2><%= msg.title %></h2>
        <p><%= msg.message %></p>
      </div>
      <% if (currentUser?.role > 0) { %>
      <span><%= msg.created_at %></span>
      <% } %>
    </div>
  </li>
  <% }) %>
</ul>