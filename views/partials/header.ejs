<header>
  <nav class="content">
    <ul class="main-links">
      <a href="/">
        <img src="/icons/account.svg" alt="">
        <span>HOME</span>
      </a>
      <li>
        <a href="/messages">
          <img src="/icons/messages.svg" alt="">
          <span>MESSAGES</span>
        </a>
      </li>
      <% if (locals.currentUser) { %>
      <li>
        <a href="/membership">
          <img src="/icons/membership.svg" alt="">
          <span>MEMBERSHIP</span>
        </a>
      </li>
      <li class="log-in-status">
        <a href="/log-out">
          <img src="/icons/logout.svg" alt="">
          <span>LOG OUT</span>
        </a>
      </li>
      <% } else { %>
      <li class="log-in-status">
        <a href="/sign-up">
          <img src="/icons/register.svg" alt="">
          <span>SIGN UP</span>
        </a>
      </li>
      <% } %>
    </ul>
  </nav>
</header>