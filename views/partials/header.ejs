<header>
  <nav class="content">
    <ul class="main-links">
      <a href="/">
        <% if (locals.currentUser) { %>
        <img src="<%= currentUser.role == 0 ? '/icons/account.svg' : currentUser.role === 1 ? '/icons/account-star.svg' : '/icons/account-tie.svg' %>" alt="">
        <span>YOU</span>
        <% } else { %>
        <img src="/icons/login.svg" alt="">
        <span>LOG IN</span>
        <% } %>
      </a>
      <li>
        <a href="/messages">
          <img src="/icons/messages.svg" alt="">
          <span>MESSAGES</span>
        </a>
      </li>
      <% if (locals.currentUser) { %>
      <li>
        <a href="/membership">
          <img src="/icons/membership.svg" alt="">
          <span>MEMBERSHIP</span>
        </a>
      </li>
      <li class="log-in-status">
        <a href="/log-out">
          <img src="/icons/logout.svg" alt="">
          <span>LOG OUT</span>
        </a>
      </li>
      <% } else { %>
      <li class="log-in-status">
        <a href="/sign-up">
          <img src="/icons/register.svg" alt="">
          <span>SIGN UP</span>
        </a>
      </li>
      <% } %>
    </ul>
  </nav>
</header>