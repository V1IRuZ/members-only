<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ADMIN</title>
  <link rel="stylesheet" href="/styles.css">
</head>

<body>
  <div class="page">
    <%- include('partials/header') %>
    <main class="content">
      <% if (currentUser?.role > 1) { %>
      <div class="admin-rights">
        <h2>You have administrator rights!</h2>
        <a href="/messages">TO THE MESSAGES</a>
      </div>
      <% } else { %>
      <form action="/admin" method="post">
        <%- include('partials/errors', {errors: errors}) %>
        <h2>Upgrade user to administrator</h2>
        <div class="input">
          <label for="admin">PASSCODE</label>
          <input type="password" id="admin" name="admin">
        </div>
      </form>
      <% } %>
    </main>
    <%- include('partials/footer') %>
  </div>
</body>

</html>