<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Homepage</title>
  <link rel="stylesheet" href="/styles.css">
</head>

<body>
  <div class="page">
    <%- include('partials/header') %>
    <main class="content index">
      <% if (locals.currentUser) { %>
      <div class="current-user">
        <img src="<%= currentUser.is_member ? '/icons/account-star.svg' : '/icons/account.svg' %>" alt="">
        <div class="details">
          <h1>WELCOME BACK <%= currentUser.username %></h1>
          <h2><%= currentUser.firstname %> <%= currentUser.lastname %></h2>
          <h2>ACCOUNT: <%= currentUser.is_member ? "MEMBER" : "STANDARD" %></h2>
          <h3>Posts: <%= messagesCount %></h3>
        </div>
      </div>
      <a href="/log-out">LOG OUT</a>
      <% } else { %>
      <form action="/log-in" class="login-form" method="post">
        <h2>LOG IN</h2>
        <% if (locals.loginMessage) { %>
        <p class="login-message"><%= loginMessage %></p>
        <% } %>
        <div class="input">
          <label for="login-user">USERNAME</label>
          <input type="text" id="login-user" name="username">
        </div>
        <div class="input">
          <label for="login-pw">PASSWORD</label>
          <input type="password" id="login-pw" name="password">
        </div>
        <div class="btns">
          <button type="submit">LOG IN</button>
          <a href="/sign-up">CREATE ACCOUNT</a>
        </div>
      </form>
      <% } %>
      <h2>MEMBER MESSAGES</h2>
      <%- include('partials/message-list', {msgs: msgs}) %>
    </main>
    <%- include('partials/footer') %>
  </div>
</body>

</html>