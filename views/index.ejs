<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Homepage</title>
  <link rel="stylesheet" href="/styles.css">
</head>

<body>
  <div class="page">
    <%- include('partials/header') %>
    <main class="content index">
      <% if (locals.currentUser) { %>
      <div class="current-user">
        <img src="<%= currentUser.role == 0 ? '/icons/account.svg' : currentUser.role == 1 ? '/icons/account-star.svg' : '/icons/account-tie.svg' %>" alt="">
        <div class="details">
          <h1>WELCOME BACK <%= currentUser.username %>!</h1>
          <h2>NAME: <%= currentUser.firstname %> <%= currentUser.lastname %></h2>
          <h2>ACCOUNT: <%= currentUser.role == 0 ? "STANDARD" : currentUser.role == 1 ? "MEMBER" : "ADMIN" %></h2>
          <h2>Posts: <%= messagesCount %></h2>
        </div>
        <div class="options">
          <a href="/messages/new" class="new-message">
            <img src="/icons/add.svg" alt="">
            <span>NEW MESSAGE</span>
          </a>
          <a href="/change-password">CHANGE PASSWORD</a>
        </div>
      </div>
      <% } else { %>
      <form action="/log-in" class="login-form" method="post">
        <img src="/icons/account.svg" alt="">
        <% if (locals.loginMessage) { %>
        <p class="login-message"><%= loginMessage %></p>
        <% } %>
        <div class="input">
          <label for="login-user">USERNAME</label>
          <input type="text" id="login-user" name="username">
        </div>
        <div class="input">
          <label for="login-pw">PASSWORD</label>
          <input type="password" id="login-pw" name="password">
        </div>
        <div class="btns">
          <button type="submit">LOG IN</button>
          <a href="/sign-up">CREATE ACCOUNT</a>
        </div>
      </form>
      <% } %>
      <h2 class="posts">Latest posts from members</h2>
      <%- include('partials/message-list', {msgs: msgs}) %>
    </main>
    <%- include('partials/footer') %>
  </div>
</body>

</html>